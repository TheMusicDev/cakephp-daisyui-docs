{
    "config": {
        "fail-on-first-error": true
    },
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\Ramsey\\CaptainHook\\ValidateConventionalCommit",
                "options": {
                    "config": {
                        "typeCase": "lower",
                        "types": ["build", "chore", "ci", "docs", "perf", "refactor", "revert", "style", "test"],
                        "scopeCase": "kebab",
                        "descriptionEndMark": ""
                    }
                }
            }
        ]
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            { "action": "composer cs-check" },
            { "action": "vendor/bin/phpunit" }
        ]
    }
}